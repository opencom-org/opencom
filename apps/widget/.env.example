# Copy this file to .env.local and fill in your values

# Convex deployment URL (required)
# Tip: ./scripts/update-env.sh fills this in automatically for local setup
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Workspace ID from the local bootstrap or app settings screen (required for dev mode)
VITE_WORKSPACE_ID=your_workspace_id_here
