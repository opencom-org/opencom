# Opencom web dashboard local defaults
# Copy to .env.local for manual setup, or run ./scripts/update-env.sh

# Backend URL used by the backend picker/discovery flow
NEXT_PUBLIC_OPENCOM_DEFAULT_BACKEND_URL=https://your-deployment.convex.cloud

# Convex URL used by widget preview/demo and local helper flows
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Optional: workspace used by the local widget demo page
NEXT_PUBLIC_TEST_WORKSPACE_ID=your-workspace-id

# Optional: backend override used by Playwright helpers
E2E_BACKEND_URL=https://your-deployment.convex.cloud
