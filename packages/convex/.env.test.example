# Test environment configuration
# This file should be used when running tests against the test Convex deployment

# Convex test deployment URL
# Using dev deployment for now - ideally create a separate test project
CONVEX_URL=

# Site URL for Convex Auth (required for OTP email verification)
# Use http://localhost:3000 for local development
# Update to production URL when deploying
SITE_URL=http://localhost:3000

# Shared secret for calling internal test mutations via the testAdmin gateway action.
# Must match the TEST_ADMIN_SECRET env var set on the Convex deployment.
TEST_ADMIN_SECRET=

# Must be set to "true" on the Convex deployment to enable test data mutations
# npx convex env set ALLOW_TEST_DATA true

# To set up a dedicated test deployment:
# 1. cd packages/convex
# 2. pnpm exec convex dev --once --configure
# 3. Reuse or create a dedicated test deployment when the CLI prompts you
# 4. Update CONVEX_URL above with the test deployment URL
# 5. Run ../../scripts/setup.sh once, or configure Convex Auth JWT_PRIVATE_KEY/JWKS with pnpm exec convex auth add
# 6. Set SITE_URL in Convex dashboard: pnpm exec convex env set SITE_URL http://localhost:3000
# 7. Set ALLOW_TEST_DATA: pnpm exec convex env set ALLOW_TEST_DATA true
# 8. Set TEST_ADMIN_SECRET: pnpm exec convex env set TEST_ADMIN_SECRET <your-secret>
# 9. Copy the same secret into TEST_ADMIN_SECRET above
